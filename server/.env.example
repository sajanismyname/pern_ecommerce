PORT=5000

# PostgreSQL (values from pgAdmin's connection properties for your server)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_pgadmin_password
PG_DATABASE=pern_ecommerce

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173
